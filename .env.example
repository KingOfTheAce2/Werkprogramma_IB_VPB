# Microsoft Azure AD Configuration (voor productie)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# Session Security
SESSION_SECRET=your-secure-session-secret-change-in-production

# Environment
NODE_ENV=development

# AuditCase API Configuration  
AUDITCASE_API_URL=https://ac.klant.nl/ac/api

# Server Configuration
PORT=3000

# Security Settings
HTTPS_ONLY=false
TRUST_PROXY=false

# Database Configuration (voor toekomstige uitbreiding)
# DATABASE_URL=postgresql://username:password@localhost:5432/werkprogramma